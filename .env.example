# --- Database ---------------------------------------------------------------
# Local MongoDB Community (pnpm services  /  docker compose up -d):
MONGODB_URI=mongodb://localhost:27017/latexresume
# MongoDB Atlas on Cloudflare Workers: use the *standard* (non-SRV) connection string
# ("mongodb://host1:27017,host2:27017,host3:27017/latexresume?ssl=true&replicaSet=...&authSource=admin"),
# because Workers cannot resolve mongodb+srv:// DNS SRV records.

# --- Security ---------------------------------------------------------------
# REQUIRED. Generate each with:  openssl rand -base64 48
# Production refuses to start with the placeholder values below.
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_SECRET=change-me-to-another-long-random-string

# Set to "false" to close registration once your own account exists.
ALLOW_SIGNUP=true

# --- LaTeX compiler service (see compiler/) ---------------------------------
LATEX_COMPILER_URL=http://localhost:9000
# Optional shared secret; must match the compiler's AUTH_TOKEN. For local docker compose
# start the stack with:  docker compose --env-file .env.local up -d   (or: pnpm services)
LATEX_COMPILER_TOKEN=

# --- Optional AI ------------------------------------------------------------
# Server-wide default OpenAI key (users can also bring their own key in Settings).
OPENAI_API_KEY=
# Allow users to point the AI base URL at private/loopback hosts (e.g. Ollama on the same machine).
# Always allowed in development; off by default in production (SSRF protection).
# ALLOW_PRIVATE_AI_URLS=false

# --- Rate limiting / proxies ---------------------------------------------------
# Login, signup and compile are rate limited. Set TRUST_PROXY=true ONLY when running behind a reverse proxy that
# sets X-Forwarded-For (Cloudflare Workers uses cf-connecting-ip automatically).
# TRUST_PROXY=false
# Multiplier for the built-in limits (default 1 in production, 100 in development).
# RATE_LIMIT_SCALE=1
# Disable user-supplied AI base URLs entirely (recommended on shared/multi-tenant hosts).
# ALLOW_CUSTOM_AI_URLS=true

# --- Optional UI -------------------------------------------------------------
# Show GitHub links in the UI (build-time variable).
NEXT_PUBLIC_REPO_URL=
